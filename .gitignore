# Binaries exceeding GitHub's 100MB limit
ffmpeg.exe
ffprobe.exe

# Python compilation cache
__pycache__/
*.py[cod]
*$py.class

# Keep compiled core modules required for standalone execution
!backend/*.pyc

# Local runtime data
WebData/
*.log

# Scratch and OS metadata
.DS_Store
Thumbs.db

# Secrets and environment
.env
*.env

# Runtime media directories
temp_media/
output_clips/
.pytest_cache/

# Local SQLite database
*.db

# Frontend build & dependencies
frontend/node_modules/
frontend/.next/
frontend/out/

